<?xml version="1.0" encoding="utf-8"?>
<!--
   Only the cache folders the app shares files from. Each other app gets access to a single
   file per grant; nothing else of the app's storage or of shared storage is reachable.
-->
<paths>
    <!-- Bug reports (BugReportBottomSheet) -->
    <cache-path
        name="reports"
        path="reports/" />
    <!-- QR code images (QrCodeGenerator) -->
    <cache-path
        name="shared_qr"
        path="shared_qr/" />
    <!-- Daily wallpaper handed to the wallpaper picker (WallpaperRepository) -->
    <cache-path
        name="shared_wallpaper"
        path="shared_wallpaper/" />
    <!-- APKs handed to the package installer (AutoUpdateManagerHelper, AppUpdatesViewModel) -->
    <cache-path
        name="updates"
        path="updates/" />
    <cache-path
        name="apk_downloads"
        path="apk_downloads/" />
</paths>
